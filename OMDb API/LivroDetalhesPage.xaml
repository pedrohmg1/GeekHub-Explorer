<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OMDb_API.LivroDetalhesPage"
             Title="Detalhes da Obra"
             BackgroundColor="#070913">

    <ScrollView Padding="40">
        <VerticalStackLayout Spacing="25">
            <Button Text="← Voltar" Clicked="BotaoVoltar_Clicked"
                    HorizontalOptions="Start" BackgroundColor="#0E1326" BorderColor="#A855F7" BorderWidth="1" TextColor="#D8B4FE" FontAttributes="Bold" CornerRadius="10" Padding="18,10"/>

            <ActivityIndicator x:Name="LoadingDetalhes" Color="#A855F7" IsVisible="True" IsRunning="True" HorizontalOptions="Center"/>

            <Border x:Name="CartaoLivro" IsVisible="False" StrokeShape="RoundRectangle 16" Padding="32" BackgroundColor="#12101D" Stroke="#A855F7" StrokeThickness="1.5">
                <Grid ColumnDefinitions="280, *" ColumnSpacing="35">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#9333EA" StrokeThickness="1.5" VerticalOptions="Start">
                        <Image x:Name="CapaLivroDetalhe" HeightRequest="380" Aspect="AspectFit"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="14">
                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#3B0764" Padding="10,4" HorizontalOptions="Start" StrokeThickness="0">
                            <Label Text="// LITERARY WORK • OPEN LIBRARY" FontSize="11" FontAttributes="Bold" TextColor="#E9D5FF" CharacterSpacing="1.2"/>
                        </Border>

                        <Label x:Name="TituloLivroDetalhe" FontSize="32" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="ResumoPolimorfico" FontSize="16" TextColor="#D8B4FE" FontAttributes="Italic" />
                        <BoxView HeightRequest="1" Color="#2E1065" Margin="0,4" />
                        <Label x:Name="SinopseLivroDetalhe" FontSize="15" LineHeight="1.35" TextColor="#E2E8F0" MaxLines="10" LineBreakMode="TailTruncation" />
                        <BoxView HeightRequest="1" Color="#2E1065" Margin="0,4" />

                        <Label x:Name="AssuntosLivro" FontSize="14" TextColor="#94A3B8"/>
                        <Label x:Name="PaginasLivro" FontSize="14" TextColor="#94A3B8"/>

                        <HorizontalStackLayout Spacing="15" Margin="0,12,0,0">
                            <Button x:Name="BotaoFavoritarLivro"
                                    Text="☆ Salvar Leitura"
                                    Clicked="BotaoFavoritarLivro_Clicked"
                                    BackgroundColor="#2E1065"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Padding="20,12"
                                    CornerRadius="10"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- INTEGRAÇÃO CRUZADA: ADAPTAÇÕES EM FILMES/SÉRIES (OMDb API) -->
            <Border x:Name="SecaoFilmesDoLivro" IsVisible="False" StrokeShape="RoundRectangle 16" Padding="24" BackgroundColor="#141318" Stroke="#F5C518" StrokeThickness="1.5">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#33270B" Padding="8,4" StrokeThickness="0">
                            <Label Text="CROSS-API LINK" FontSize="10" FontAttributes="Bold" TextColor="#F5C518" CharacterSpacing="1.2"/>
                        </Border>
                        <Label Text="🎬 Adaptações em Filmes e Séries (OMDb API)" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <CollectionView x:Name="ListaFilmesDoLivro" HeightRequest="315"
                                    SelectionMode="Single" SelectionChanged="ListaFilmesDoLivro_SelectionChanged">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#1C1B22" Stroke="#4D3E14" StrokeThickness="1" Padding="12" WidthRequest="195">
                                    <VerticalStackLayout Spacing="8">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="210">
                                            <Image Source="{Binding ImagemUrl}" Aspect="AspectFit"/>
                                        </Border>
                                        <Label Text="{Binding Titulo}" FontSize="14" FontAttributes="Bold" TextColor="White" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Ano}" FontSize="12" TextColor="#F5C518" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>