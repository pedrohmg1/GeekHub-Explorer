<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OMDb_API.MainPage"
             Title="Filmes"
             BackgroundColor="#0B0C10">

    <Grid>
        <CollectionView x:Name="ListaFilmes" Margin="40,0,40,25"
                        SelectionMode="Single" SelectionChanged="ListaFilmes_SelectionChanged">

            <!-- Cabeçalho + Barra de Pesquisa rolam junto com a lista -->
            <CollectionView.Header>
                <Grid Padding="20,30,20,25" Margin="0,0,0,10">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#271D08" Offset="0.0" />
                            <GradientStop Color="#0B0C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#33270B" Stroke="#F5C518" StrokeThickness="1" Padding="14,5" HorizontalOptions="Center">
                            <Label Text="🎬 CINEVAULT • OMDb ENGINE" FontSize="11" FontAttributes="Bold" TextColor="#F5C518" CharacterSpacing="1.5"/>
                        </Border>

                        <Label Text="Explore o Universo do Cinema" FontSize="38" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                        <Label Text="Busque filmes e séries para ver detalhes e descobrir jogos da mesma franquia" FontSize="15" HorizontalOptions="Center" TextColor="#A1A1AA"/>

                        <Border StrokeShape="RoundRectangle 12" Padding="14,10" BackgroundColor="#161821" Stroke="#3F3314" StrokeThickness="1.5" HorizontalOptions="Center" WidthRequest="540" Margin="0,8,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#F5C518" Offset="0,4" Radius="14" Opacity="0.12"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🔍" FontSize="18" VerticalOptions="Center"/>
                                <Entry x:Name="FilmeEntry" Placeholder="Ex.: Batman, The Witcher, Star Wars, Matrix..." PlaceholderColor="#71717A" TextColor="White" WidthRequest="470" TextChanged="FilmeEntry_TextChanged" />
                            </HorizontalStackLayout>
                        </Border>

                        <ActivityIndicator x:Name="LoadingIndicator" Color="#F5C518" IsVisible="False" IsRunning="False" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="22" HorizontalItemSpacing="22" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 14" BackgroundColor="#14161F" Stroke="#262936" StrokeThickness="1.5" Padding="14" HeightRequest="410">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,8" Radius="14" Opacity="0.45"/>
                        </Border.Shadow>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#F5C518" />
                                        <Setter Property="BackgroundColor" Value="#1B1E2B" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="265" BackgroundColor="#0B0C10">
                                <Image Source="{Binding ImagemUrl}" Aspect="AspectFit"/>
                            </Border>

                            <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation"/>

                            <Border StrokeShape="RoundRectangle 6" BackgroundColor="#232018" Stroke="#4D3E14" StrokeThickness="1" Padding="10,3" HorizontalOptions="Center">
                                <Label Text="{Binding Ano}" FontSize="12" FontAttributes="Bold" TextColor="#F5C518"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>