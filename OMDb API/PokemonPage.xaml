<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OMDb_API.PokemonPage"
             Title="Pokémon TCG"
             BackgroundColor="#0F111A">

    <Grid>
        <CollectionView x:Name="ListaPokemon"
                        SelectionMode="Single" SelectionChanged="ListaPokemon_SelectionChanged">

            <!-- Cabeçalho ocupa 100% da largura e dissolve suavemente para baixo -->
            <CollectionView.Header>
                <Grid Padding="40,30,40,35">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4C0B10" Offset="0.0" />
                            <GradientStop Color="#231324" Offset="0.55" />
                            <GradientStop Color="#0F111A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Ellipse WidthRequest="16" HeightRequest="16" Fill="#38BDF8" Stroke="White" StrokeThickness="1.5"/>
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#EF4444"/>
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#FACC15"/>
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#22C55E"/>
                            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#3B0D11" Stroke="#EF4444" StrokeThickness="1" Padding="12,4" Margin="6,0,0,0">
                                <Label Text="POKÉDEX TCG • COLLECTOR VAULT" FontSize="11" FontAttributes="Bold" TextColor="#FCA5A5" CharacterSpacing="1.5"/>
                            </Border>
                        </HorizontalStackLayout>

                        <Label Text="Enciclopédia de Cartas Pokémon" FontSize="38" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                        <Label Text="Pesquise cartas oficiais, confira ataques, raridade e monte sua coleção favorita" FontSize="15" HorizontalOptions="Center" TextColor="#CBD5E1"/>

                        <Border StrokeShape="RoundRectangle 12" Padding="14,10" BackgroundColor="#181B29" Stroke="#EF4444" StrokeThickness="1.5" HorizontalOptions="Center" WidthRequest="540" Margin="0,8,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#EF4444" Offset="0,4" Radius="16" Opacity="0.22"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🔴" FontSize="18" VerticalOptions="Center"/>
                                <Entry x:Name="PokemonEntry" Placeholder="Ex.: Charizard, Umbreon, Pikachu, Rayquaza, Mew..." PlaceholderColor="#64748B" TextColor="White" WidthRequest="470" TextChanged="PokemonEntry_TextChanged" />
                            </HorizontalStackLayout>
                        </Border>

                        <ActivityIndicator x:Name="LoadingIndicator" Color="#EF4444" IsVisible="False" IsRunning="False" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="0" HorizontalItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="14,10">
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="#181B29" Stroke="#332938" StrokeThickness="1.5" Padding="14" HeightRequest="405">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,8" Radius="14" Opacity="0.5"/>
                            </Border.Shadow>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#FACC15" />
                                            <Setter Property="BackgroundColor" Value="#212538" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                <Image Source="{Binding ImagemUrl}" HeightRequest="260" Aspect="AspectFit"/>
                                <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                <Border StrokeShape="RoundRectangle 6" BackgroundColor="#2A1822" Stroke="#EF4444" StrokeThickness="1" Padding="10,3" HorizontalOptions="Center">
                                    <Label Text="{Binding Colecao}" FontSize="12" FontAttributes="Bold" TextColor="#FACC15" MaxLines="1" LineBreakMode="TailTruncation"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>