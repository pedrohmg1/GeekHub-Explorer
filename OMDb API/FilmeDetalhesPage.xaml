<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OMDb_API.FilmeDetalhesPage"
             Title="Detalhes do Filme"
             BackgroundColor="#0B0C10">

    <ScrollView Padding="40">
        <VerticalStackLayout Spacing="25">
            <Button Text="← Voltar ao Catálogo" Clicked="BotaoVoltar_Clicked"
                    HorizontalOptions="Start" BackgroundColor="#1A1D29" BorderColor="#3F3314" BorderWidth="1" TextColor="#F5C518" FontAttributes="Bold" CornerRadius="10" Padding="18,10"/>

            <ActivityIndicator x:Name="LoadingDetalhes" Color="#F5C518" IsVisible="True" IsRunning="True" HorizontalOptions="Center"/>

            <Border x:Name="CartaoFilme" IsVisible="False" StrokeShape="RoundRectangle 16" Padding="32" BackgroundColor="#14161F" Stroke="#3F3314" StrokeThickness="1.5">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.6"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="300, *" ColumnSpacing="35">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="#F5C518" StrokeThickness="1" VerticalOptions="Start">
                        <Image x:Name="CapaFilmeDetalhe" HeightRequest="430" Aspect="AspectFit"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="14">
                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#33270B" Padding="10,4" HorizontalOptions="Start" StrokeThickness="0">
                            <Label Text="FICHA TÉCNICA • OMDb" FontSize="11" FontAttributes="Bold" TextColor="#F5C518" CharacterSpacing="1.2"/>
                        </Border>

                        <Label x:Name="TituloFilmeDetalhe" FontSize="36" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="ResumoPolimorfico" FontSize="16" TextColor="#F5C518" FontAttributes="Italic" />
                        <BoxView HeightRequest="1" Color="#2A2E3D" Margin="0,4" />
                        <Label x:Name="EnredoFilmeDetalhe" FontSize="15" LineHeight="1.3" TextColor="#E4E4E7" />
                        <BoxView HeightRequest="1" Color="#2A2E3D" Margin="0,4" />

                        <Label x:Name="DiretorFilme" FontSize="14" TextColor="#A1A1AA"/>
                        <Label x:Name="ElencoFilme" FontSize="14" TextColor="#A1A1AA"/>
                        <Label x:Name="BilheteriaFilme" FontSize="14" TextColor="#A1A1AA"/>

                        <HorizontalStackLayout Spacing="15" Margin="0,12,0,0">
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F5C518" Padding="16,10" StrokeThickness="0">
                                <Label x:Name="NotaIMDb" FontAttributes="Bold" FontSize="18" TextColor="Black" VerticalOptions="Center"/>
                            </Border>

                            <Button x:Name="BotaoFavoritar"
                                    Text="☆ Assistir no Futuro"
                                    Clicked="BotaoFavoritar_Clicked"
                                    BackgroundColor="#1E2230"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Padding="20,12"
                                    CornerRadius="10"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- INTEGRAÇÃO ENTRE APIS: JOGOS RELACIONADOS (TEMA CYBER) -->
            <Border x:Name="SecaoJogosRelacionados" IsVisible="False" StrokeShape="RoundRectangle 16" Padding="24" BackgroundColor="#101322" Stroke="#2D264B" StrokeThickness="1.5">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#2E1065" Padding="8,4" StrokeThickness="0">
                            <Label Text="CROSS-API LINK" FontSize="10" FontAttributes="Bold" TextColor="#C4B5FD" CharacterSpacing="1.2"/>
                        </Border>
                        <Label Text="🎮 Jogos desta franquia (RAWG API)" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <CollectionView x:Name="ListaJogosRelacionados" HeightRequest="265"
                                    SelectionMode="Single" SelectionChanged="ListaJogosRelacionados_SelectionChanged">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#161A2E" Stroke="#3B3166" StrokeThickness="1" Padding="12" WidthRequest="225">
                                    <VerticalStackLayout Spacing="8">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="145">
                                            <Image Source="{Binding ImagemUrl}" Aspect="AspectFill"/>
                                        </Border>
                                        <Label Text="{Binding Titulo}" FontSize="14" FontAttributes="Bold" TextColor="White" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Ano}" FontSize="12" TextColor="#06B6D4" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- SEÇÃO DE LIVROS E HQs ORIGINAIS (OPEN LIBRARY API) -->
            <Border x:Name="SecaoLivrosRelacionados" IsVisible="False" StrokeShape="RoundRectangle 16" Padding="24" BackgroundColor="#16111D" Stroke="#A855F7" StrokeThickness="1.5">
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#3B0764" Padding="8,4" StrokeThickness="0">
                            <Label Text="OPEN LIBRARY ARCHIVE" FontSize="10" FontAttributes="Bold" TextColor="#E9D5FF" CharacterSpacing="1.2"/>
                        </Border>
                        <Label Text="📚 Livros e HQs Relacionados (Open Library API)" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <CollectionView x:Name="ListaLivrosRelacionados" HeightRequest="310"
                                    SelectionMode="Single" SelectionChanged="ListaLivrosRelacionados_SelectionChanged">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#1E1729" Stroke="#7E22CE" StrokeThickness="1" Padding="12" WidthRequest="195">
                                    <VerticalStackLayout Spacing="6">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="190">
                                            <Image Source="{Binding ImagemUrl}" Aspect="AspectFit"/>
                                        </Border>
                                        <Label Text="{Binding Titulo}" FontSize="14" FontAttributes="Bold" TextColor="White" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Autor}" FontSize="12" TextColor="#D8B4FE" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Ano}" FontSize="11" TextColor="#9CA3AF"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>